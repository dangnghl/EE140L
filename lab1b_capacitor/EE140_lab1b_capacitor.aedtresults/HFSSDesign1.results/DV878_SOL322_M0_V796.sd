$begin 'soln'
	ObjectType='Terminal'
	SolutionType='DiscreteSweep'
	MajorVersion=2
	MinorVersion=0
	Producer=''
	Name='Single_100MHz'
	AdaptivePass=-1
	AllowMixedMode=false
	UseRenormedInterpolation=true
	$begin 'Frequencies'
