				$end 'B_matrix'
				$begin 'C_matrix'
					Rows()
					Cols()
					Values()
				$end 'C_matrix'
				$begin 'DmI_matrix'
					Rows()
					Cols()
					Values()
				$end 'DmI_matrix'
			$end 'Port ABCD'
			EnergyError=0
			IeEnergyError=0
			$begin 'PortImpedance'
				MatrixSize=1
				NumberOfBlocks=1
				Block0_Size=1
