					n=1
					$begin 'r0'
						c(93.7500697980163, -5.153140475441798e-05)
					$end 'r0'
				$end 'Zwave'
				$begin 'TerminalTMatrix'
					m=1
					n=1
					$begin 'r0'
						c(10, 0)
					$end 'r0'
				$end 'TerminalTMatrix'
				$begin 'TerminalPMatrix'
					m=1
					n=1
					$begin 'r0'
						c(1.999999999999659, -1.099335794076638e-06)
					$end 'r0'
